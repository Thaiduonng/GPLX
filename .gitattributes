# Auto detect text files and perform LF normalization
* text=auto

# Java
*.java text
*.properties text
*.xml text

# Frontend
*.js text
*.jsx text
*.ts text
*.tsx text
*.json text
*.css text
*.html text

# SQL
*.sql text

# Markdown
*.md text

# Shell scripts
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Maven Wrapper
mvnw text eol=lf
mvnw.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
